DATABASE_URL="postgresql://postgres:postgres@localhost:5433/newreplica"
PORT=4000
CORS_ORIGIN="http://localhost:5173,http://localhost:8081"
WEB_APP_URL="http://localhost:5173"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"
# Local development only: returns sign-in codes in the API response so you can test without email.
AUTH_DEV_EXPOSE_CODES=true
