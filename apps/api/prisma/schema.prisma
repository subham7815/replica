generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Roles a person can hold inside an organisation. Platform super-admin is a flag on User, not a membership role.
enum OrgRole {
  ORG_ADMIN
  COORDINATOR
  VOLUNTEER
  CHECKIN_OPERATOR
  AUDITOR
}

enum MemberStatus {
  ACTIVE
  INVITED
  INACTIVE
  SUSPENDED
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  contactEmail String?
  phone        String?
  website      String?
  description  String?
  timezone     String   @default("Europe/London")
  brandColor   String   @default("#c7102c")
  logoUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   Membership[]
  locations     Location[]
  departments   Department[]
  opportunities Opportunity[]
  applications  Application[]
  events        Event[]
  shifts        Shift[]
  assignments   ShiftAssignment[]
}

enum OpportunityStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SignupMode {
  OPEN
  APPROVAL
}

enum Visibility {
  PUBLIC
  UNLISTED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// A volunteer role an organisation recruits for. Questions is a JSON array of form-field definitions.
model Opportunity {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  summary        String
  description    String?
  commitment     String?
  locationId     String?
  location       Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  departmentId   String?
  department     Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  status         OpportunityStatus @default(DRAFT)
  signupMode     SignupMode        @default(APPROVAL)
  visibility     Visibility        @default(PUBLIC)
  questions      Json              @default("[]")
  publishedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  applications Application[]

  @@index([organizationId, status])
  @@index([status, visibility])
}

model Application {
  id             String            @id @default(cuid())
  opportunityId  String
  opportunity    Opportunity       @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone          String?
  answers        Json              @default("{}")
  status         ApplicationStatus @default(PENDING)
  reviewNote     String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([opportunityId, userId])
  @@index([organizationId, status])
}

// Global identity: one login per person, shared across every organisation they belong to.
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String?
  isPlatformAdmin Boolean   @default(false)
  disabled        Boolean   @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships  Membership[]
  loginCodes   LoginCode[]
  applications Application[]
}

// Per-organisation profile. Contact details live here so one organisation's edits never leak to another.
model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrgRole
  status         MemberStatus @default(ACTIVE)
  phone          String?
  notes          String?
  skills         String[]     @default([])
  availability   Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  departments Department[]
  assignments ShiftAssignment[]

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Location {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  opportunities Opportunity[]
  events        Event[]

  @@unique([organizationId, name])
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  memberships   Membership[]
  opportunities Opportunity[]
  events        Event[]

  @@unique([organizationId, name])
}

model LoginCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum AssignmentStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

enum AssignmentSource {
  SELF
  STAFF
}

// A programme or one-off event. Its dates come from its shifts.
model Event {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  locationId     String?
  location       Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  status         EventStatus  @default(DRAFT)
  publishedAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  shifts Shift[]

  @@index([organizationId, status])
}

model Shift {
  id              String       @id @default(cuid())
  eventId         String
  event           Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title           String
  startsAt        DateTime
  endsAt          DateTime
  capacity        Int
  waitlistEnabled Boolean      @default(true)
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  assignments ShiftAssignment[]

  @@index([eventId])
  @@index([organizationId, startsAt])
}

// One person on one shift. Cancelled rows are kept so coordinators can see who dropped out and when.
model ShiftAssignment {
  id             String           @id @default(cuid())
  shiftId        String
  shift          Shift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membershipId   String
  membership     Membership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  status         AssignmentStatus
  source         AssignmentSource @default(SELF)
  // Waitlist order. Reset when someone re-joins after cancelling.
  joinedAt       DateTime         @default(now())
  promotedAt     DateTime?
  cancelledAt    DateTime?
  cancelledById  String?
  cancelReason   String?
  lateCancel     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([shiftId, membershipId])
  @@index([shiftId, status, joinedAt])
  @@index([membershipId, status])
}
